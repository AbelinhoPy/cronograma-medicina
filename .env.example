# ==========================================
#  Configuración de Base de Datos (Neon Postgres)
# ==========================================
# Obtén tu connection string con pooling desde la consola de Neon (https://console.neon.tech)
# Ejemplo: postgresql://neondb_owner:xyz@ep-cool-fog-123-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://usuario:contraseña@ep-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ==========================================
#  Autenticación y Seguridad (Google OAuth)
# ==========================================
# Genera un secreto seguro ejecutando: npx auth secret
AUTH_SECRET="cambiar_por_un_secreto_aleatorio_seguro"

# Credenciales de Google Cloud Console (OAuth 2.0 Client IDs)
# Configura el redirect URI: https://tu-dominio.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID="tu-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="tu-google-client-secret"

# ==========================================
#  Lista Blanca y Roles de Acceso
# ==========================================
# Correos autorizados separados por coma.
ADMIN_EMAILS="abelkuarahy@gmail.com,abelkuarahy@hotmail.com"
ALLOWED_EMAILS="abelkuarahy@gmail.com,abelkuarahy@hotmail.com,yaninasebriano13@gmail.com"
